#!/usr/bin/env python3
"""A stand-in for `pi --mode rpc`, used by the test suite.

Speaks the documented JSONL protocol (verified against Pi 1.1.0) so Solo's
transport, correlation and event translation can be tested deterministically —
no network, no model, no credentials.

Behaviour is selected with FAKE_PI_MODE:
  success (default)  run to completion, creating a file with the `write` tool
  error              report a provider error in the assistant message
  cancel             wait for `abort`, then settle as aborted
  garbage            emit a malformed line before valid records
  crash              exit immediately after the prompt is accepted
  slow               stream slowly, useful for cancellation timing
  no_model           get_state reports no model
  huge               emit an oversized record to test the stream limit
"""

from __future__ import annotations

import json
import os
import sys
import time

MODE = os.environ.get("FAKE_PI_MODE", "success")


def emit(record: dict) -> None:
    sys.stdout.write(json.dumps(record) + "\n")
    sys.stdout.flush()


def respond(request_id, command, *, success=True, data=None, error=None) -> None:
    record = {
        "type": "response",
        "command": command,
        "success": success,
    }
    if request_id is not None:
        record["id"] = request_id
    if data is not None:
        record["data"] = data
    if error is not None:
        record["error"] = error
    emit(record)


def user_message(text: str) -> dict:
    return {"role": "user", "content": text, "timestamp": int(time.time() * 1000)}


def assistant_message(text: str, *, stop_reason="stop", error=None) -> dict:
    message = {
        "role": "assistant",
        "content": [{"type": "text", "text": text}],
        "api": "openai-completions",
        "provider": "fake",
        "model": "fake-model",
        "usage": {
            "input": 10,
            "output": 5,
            "cacheRead": 0,
            "cacheWrite": 0,
            "totalTokens": 15,
            "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0, "total": 0},
        },
        "stopReason": stop_reason,
        "timestamp": int(time.time() * 1000),
    }
    if error:
        message["errorMessage"] = error
    return message


def run_prompt(request_id, message, cwd) -> None:
    respond(request_id, "prompt", data={"disposition": "started"})

    emit({"type": "agent_start"})
    emit({"type": "turn_start"})
    emit({"type": "message_start", "message": user_message(message)})
    emit({"type": "message_end", "message": user_message(message)})

    if MODE == "garbage":
        sys.stdout.write("this is not json\n")
        sys.stdout.flush()

    if MODE == "error":
        emit(
            {
                "type": "message_start",
                "message": assistant_message("", stop_reason="pending"),
            }
        )
        emit(
            {
                "type": "message_end",
                "message": assistant_message(
                    "",
                    stop_reason="error",
                    error='402: {"message":"Insufficient credits","code":402}',
                ),
            }
        )
        emit({"type": "agent_end", "messages": [], "willRetry": False})
        emit({"type": "agent_settled", "aborted": False})
        return

    if MODE == "cancel":
        # Wait for the abort command before settling.
        emit({"type": "message_start", "message": assistant_message("", stop_reason="pending")})
        deadline = time.time() + 30
        while time.time() < deadline:
            line = sys.stdin.readline()
            if not line:
                break
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if record.get("type") == "abort":
                respond(record.get("id"), "abort", data={})
                emit({"type": "agent_end", "messages": [], "willRetry": False})
                emit({"type": "agent_settled", "aborted": True})
                return
            if record.get("type") == "prompt":
                respond(record.get("id"), "prompt", data={"disposition": "queued"})
        return

    delay = 0.05 if MODE != "slow" else 0.35

    # A file-writing tool call, as Pi reports it.
    tool_call_id = "call_fake_1"
    target = os.path.join(cwd, "hello_world.py")
    args = {
        "file_path": target,
        "content": "def main():\n    print('Hello World')\n\n\nif __name__ == '__main__':\n    main()\n",
    }
    emit(
        {
            "type": "message_start",
            "message": assistant_message("", stop_reason="pending"),
        }
    )
    emit(
        {
            "type": "message_update",
            "usage": {"input": 10, "output": 5, "cacheRead": 0, "cacheWrite": 0, "totalTokens": 15},
            "assistantMessageEvent": {
                "type": "text_delta",
                "contentIndex": 0,
                "delta": "Creating the file.",
            },
        }
    )
    time.sleep(delay)
    emit(
        {
            "type": "tool_execution_start",
            "toolCallId": tool_call_id,
            "toolName": "write",
            "args": args,
        }
    )
    try:
        with open(target, "w", encoding="utf-8") as handle:
            handle.write(args["content"])
    except OSError:
        pass
    time.sleep(delay)
    emit(
        {
            "type": "tool_execution_end",
            "toolCallId": tool_call_id,
            "toolName": "write",
            "result": {"content": [{"type": "text", "text": "wrote file"}]},
            "isError": False,
            "durationMs": 12,
        }
    )
    time.sleep(delay)

    # A test-running bash tool call.
    bash_id = "call_fake_2"
    emit(
        {
            "type": "tool_execution_start",
            "toolCallId": bash_id,
            "toolName": "bash",
            "args": {"command": "python3 -m pytest -q"},
        }
    )
    time.sleep(delay)
    emit(
        {
            "type": "bash_execution_update",
            "id": bash_id,
            "delta": "3 passed in 0.12s\n",
        }
    )
    emit(
        {
            "type": "tool_execution_end",
            "toolCallId": bash_id,
            "toolName": "bash",
            "result": {"content": [{"type": "text", "text": "3 passed in 0.12s"}]},
            "isError": False,
            "durationMs": 120,
        }
    )

    emit(
        {
            "type": "message_end",
            "message": assistant_message(
                "I created hello_world.py and ran the tests: 3 passed."
            ),
        }
    )
    emit({"type": "turn_end", "message": assistant_message("done"), "toolResults": []})
    emit({"type": "agent_end", "messages": [], "willRetry": False})
    emit({"type": "agent_settled", "aborted": False})


def main() -> None:
    argv = sys.argv[1:]

    # CLI subcommands (not RPC): used for version detection, auth checks and
    # catalog refresh. The real Pi handles these without a JSONL session.
    if "--version" in argv or "-v" in argv:
        print("1.1.0-fake")
        return
    if "auth" in argv and "check" in argv:
        provider = None
        for index, item in enumerate(argv):
            if item == "--provider" and index + 1 < len(argv):
                provider = argv[index + 1]
        payload = {"provider": provider}
        if provider == "unconfigured-provider":
            payload.update(status="not_ready", reason="credentials_not_configured")
        elif provider == "unknown-provider":
            payload.update(status="not_ready", reason="provider_not_found")
        else:
            payload.update(status="ready", authType="api_key")
        print(json.dumps(payload))
        return 1 if payload["status"] != "ready" else 0
    if "update" in argv:
        print("Model catalogs refreshed (fake)")
        return

    while True:
        line = sys.stdin.readline()
        if not line:
            break
        try:
            command = json.loads(line)
        except ValueError:
            respond(None, "parse", success=False, error="Failed to parse command")
            continue

        kind = command.get("type")
        request_id = command.get("id")

        if kind == "get_state":
            if MODE == "no_model":
                respond(request_id, "get_state", data={"isStreaming": False})
            else:
                respond(
                    request_id,
                    "get_state",
                    data={
                        "model": {
                            "id": "fake-model",
                            "provider": "fake",
                            "api": "openai-completions",
                        },
                        "thinkingLevel": "medium",
                        "isStreaming": False,
                        "isCompacting": False,
                        "messageCount": 0,
                        "pendingMessageCount": 0,
                    },
                )
        elif kind == "get_available_models":
            respond(
                request_id,
                "get_available_models",
                data={
                    "models": [
                        {
                            "id": "fake-model",
                            "name": "Fake Model",
                            "provider": "fake",
                            "api": "openai-completions",
                            "reasoning": True,
                            "input": ["text"],
                            "contextWindow": 128000,
                            "maxTokens": 8192,
                        },
                        {
                            "id": "second-model",
                            "name": "Second Model",
                            "provider": "fake",
                            "api": "openai-completions",
                            "reasoning": False,
                            "input": ["text", "image"],
                            "contextWindow": 64000,
                            "maxTokens": 4096,
                        },
                    ]
                },
            )
        elif kind == "get_session_stats":
            respond(
                request_id,
                "get_session_stats",
                data={"toolCalls": 2, "tokens": {"total": 15}, "cost": 0.0},
            )
        elif kind == "bash":
            command_text = str(command.get("command") or "")
            output = "fake-bash-output\n"
            if command_text:
                os.system(f"{command_text} >/dev/null 2>&1 || true")
            emit({"type": "bash_execution_update", "id": request_id, "delta": output})
            respond(
                request_id,
                "bash",
                data={
                    "output": output,
                    "exitCode": 0,
                    "cancelled": False,
                    "truncated": False,
                },
            )
        elif kind == "prompt":
            if MODE == "crash":
                respond(request_id, "prompt", data={"disposition": "started"})
                sys.exit(3)
            run_prompt(request_id, str(command.get("message") or ""), os.getcwd())
        elif kind == "abort":
            respond(request_id, "abort", data={})
            emit({"type": "agent_settled", "aborted": True})
        elif kind == "set_model":
            respond(
                request_id,
                "set_model",
                data={
                    "id": command.get("modelId"),
                    "provider": command.get("provider"),
                    "api": "openai-completions",
                },
            )
        elif kind == "set_thinking_level":
            respond(request_id, "set_thinking_level", data={})
        elif kind == "new_session":
            respond(request_id, "new_session", data={"cancelled": False})
        else:
            respond(request_id, kind or "unknown", success=False, error="unsupported command")


if __name__ == "__main__":
    main()
