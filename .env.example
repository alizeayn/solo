# Solo — operational settings (NON-SECRET)
# =============================================================================
# Copy to `.env` and adjust. Do NOT put API keys in this file.
# Provider API keys (OpenRouter, ElevenLabs) and the admin password are
# configured through the Settings UI and stored server-side (encrypted).
# =============================================================================

# Directory that holds the SQLite DB, encrypted secrets and imported projects.
# Inside Docker this is normally /data (a persistent volume).
APP_DATA_DIR=./data

# Public port the app listens on (single user-facing origin).
APP_PORT=8080

# Bind address for the dev server. Use 0.0.0.0 in containers.
APP_HOST=0.0.0.0

# Session lifetime in hours.
SESSION_TTL_HOURS=168

# Mark the session cookie "Secure".
#   leave unset  -> auto: Secure only when the request arrives over HTTPS
#   true/false   -> force it on or off
# Auto is correct in almost every case: browsers reject Secure cookies over
# plain http, which would make sign-in look successful but fail every request.
# SESSION_COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# Projects
# -----------------------------------------------------------------------------
# Name of the per-project state directory created inside each project root.
METADATA_DIR_NAME=.solo

# Extra roots that "Open Project" may read, separated by ":".
PROJECT_ROOTS=

# When true (default) any readable folder may be opened, except the always-
# blocked system paths and the Solo data directory. Set to false to restrict
# opening to PROJECT_ROOTS plus your home directory and the managed workspaces
# folder. RECOMMENDED false if you expose Solo beyond your own machine.
ALLOW_ANY_PROJECT_PATH=true

# Bounds for the generated project state tree.
MAX_TREE_DEPTH=10
MAX_TREE_ENTRIES=5000

# Write a .gitignore inside each project's state directory so Solo state does
# not pollute your repository. Solo never edits a repository's own .gitignore.
METADATA_WRITE_GITIGNORE=true

# -----------------------------------------------------------------------------
# Coding agent
# -----------------------------------------------------------------------------
# "mock" (this phase) or "pi" (from Phase 2).
AGENT_BACKEND=mock

# Seconds between simulated steps of the mock agent. Set 0 for instant runs.
MOCK_STEP_DELAY=0.35

# Maximum accepted project ZIP upload size, in megabytes.
MAX_UPLOAD_MB=200

# Extraction guards for imported archives.
MAX_ZIP_ENTRIES=20000
MAX_UNCOMPRESSED_MB=2048

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Set to "production" in deployed environments (enables Secure cookies).
APP_ENV=development

# Optional: path to a directory (inside the container) that holds the built
# frontend. Left unset in dev, where Vite serves the frontend on its own port.
# FRONTEND_DIST=/app/frontend/dist
